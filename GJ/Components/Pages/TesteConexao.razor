@page "/teste-conexao"

@rendermode InteractiveServer
@using GJ.Services
@inject ITerceiroService TerceiroService

<PageTitle>Teste de Conexão</PageTitle>


    <h3>Teste de Conexão com Banco de Dados - .NET 9</h3>

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="TestarConexao">Testar Conexão com GJBase</button>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <div class="spinner-border spinner-border-sm me-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            Testando conexão com o banco de dados...
        </div>
    }

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="alert @alertClass">
            <h5>@(sucesso ? "✅ Sucesso!" : "❌ Erro!")</h5>
            @mensagem
        </div>
    }

@code {
    private bool isLoading = false;
    private string mensagem = string.Empty;
    private bool sucesso = false;

    private string alertClass => sucesso ? "alert-success" : "alert-danger";

    private async Task TestarConexao()
    {
        isLoading = true;
        mensagem = string.Empty;
        StateHasChanged();

        try
        {
            var terceiros = await TerceiroService.GetTerceirosAsync();
            sucesso = true;
            mensagem = $"Conexão bem-sucedida! Encontrados {terceiros.Count} terceiros na base de dados GJBase.";
        }
        catch (Exception ex)
        {
            sucesso = false;
            mensagem = $"Erro na conexão: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}