@page "/terceiros/novo"
@rendermode InteractiveServer
@using GJ.Models
@using GJ.Services
@inject ITerceiroService TerceiroService
@inject NavigationManager Navigation

<PageTitle>GJ - Novo Terceiro</PageTitle>

<h3>Adicionar Novo Terceiro</h3>

<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label for="nome">Nome *</label>
            <input id="nome" @bind="terceiro.Nome" class="form-control" />
            @if (showValidation && string.IsNullOrEmpty(terceiro.Nome))
            {
                <small class="text-danger">Nome é obrigatório</small>
            }
        </div>

        <div class="form-group mb-3">
            <label for="nif">NIF</label>
            <input id="nif" @bind="terceiro.Nif" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label for="telefone">Telefone</label>
            <input id="telefone" @bind="terceiro.Telefone" class="form-control" />
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">
            <label for="email">Email</label>
            <input id="email" @bind="terceiro.Email" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label for="morada">Morada</label>
            <input id="morada" @bind="terceiro.Morada" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label for="cpostal">Código Postal</label>
            <input id="cpostal" @bind="terceiro.CPostal" class="form-control" />
        </div>
    </div>
</div>

<div class="form-group mb-3">
    <button @onclick="SalvarTerceiro" class="btn btn-success" disabled="@isLoading">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </span>
        }
        <i class="bi bi-check-circle"></i> Guardar
    </button>

    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar">
        <i class="bi bi-x-circle"></i> Cancelar
    </button>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger") mt-3">
        @mensagem
    </div>
}

@code {
    private Terceiro terceiro = new();
    private bool isLoading = false;
    private string mensagem = string.Empty;
    private bool sucesso = false;
    private bool showValidation = false;

    private async Task SalvarTerceiro()
    {
        showValidation = true;

        // Validação manual
        if (string.IsNullOrEmpty(terceiro.Nome))
        {
            mensagem = "O campo Nome é obrigatório.";
            sucesso = false;
            StateHasChanged();
            return;
        }

        isLoading = true;
        mensagem = string.Empty;
        StateHasChanged();

        try
        {
            var resultado = await TerceiroService.CreateTerceiroAsync(terceiro);

            if (resultado)
            {
                sucesso = true;
                mensagem = "Terceiro adicionado com sucesso!";

                // Limpar formulário após sucesso
                terceiro = new Terceiro();
                showValidation = false;

                // Redirecionar após 1 segundo
                await Task.Delay(1000);
                Navigation.NavigateTo("/terceiros");
            }
            else
            {
                sucesso = false;
                mensagem = "Erro ao adicionar terceiro. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            sucesso = false;
            mensagem = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/terceiros");
    }
}
