@page "/terceiros/editar/{Id:int}"
@rendermode InteractiveServer
@using GJ.Models
@using GJ.Services
@inject ITerceiroService TerceiroService
@inject NavigationManager Navigation

<PageTitle>GJ - Editar Terceiro</PageTitle>

<h3>Editar Terceiro</h3>

@if (isLoading && terceiro == null)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">A carregar...</span>
        </div>
    </div>
}
else if (terceiro == null)
{
    <div class="alert alert-danger">
        Terceiro não encontrado.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label for="nome">Nome *</label>
                <input id="nome" @bind="terceiro.Nome" class="form-control" />
                @if (showValidation && string.IsNullOrEmpty(terceiro.Nome))
                {
                    <small class="text-danger">Nome é obrigatório</small>
                }
            </div>

            <div class="form-group mb-3">
                <label for="nif">NIF</label>
                <input id="nif" @bind="terceiro.Nif" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="telefone">Telefone</label>
                <input id="telefone" @bind="terceiro.Telefone" class="form-control" />
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group mb-3">
                <label for="email">Email</label>
                <input id="email" @bind="terceiro.Email" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="morada">Morada</label>
                <input id="morada" @bind="terceiro.Morada" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="cpostal">Código Postal</label>
                <input id="cpostal" @bind="terceiro.CPostal" class="form-control" />
            </div>
        </div>
    </div>

    <div class="form-group mb-3">
        <button @onclick="AtualizarTerceiro" class="btn btn-success" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status">
                    <span class="visually-hidden">Loading...</span>
                </span>
            }
            <i class="bi bi-check-circle"></i> Atualizar
        </button>

        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar">
            <i class="bi bi-x-circle"></i> Cancelar
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="alert @(sucesso ? "alert-success" : "alert-danger") mt-3">
            @mensagem
        </div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Terceiro? terceiro;
    private bool isLoading = false;
    private string mensagem = string.Empty;
    private bool sucesso = false;
    private bool showValidation = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarTerceiro();
    }

    private async Task CarregarTerceiro()
    {
        isLoading = true;
        StateHasChanged();

        terceiro = await TerceiroService.GetTerceiroByIdAsync(Id);

        isLoading = false;
        StateHasChanged();
    }

    private async Task AtualizarTerceiro()
    {
        if (terceiro == null) return;

        showValidation = true;

        // Validação manual
        if (string.IsNullOrEmpty(terceiro.Nome))
        {
            mensagem = "O campo Nome é obrigatório.";
            sucesso = false;
            StateHasChanged();
            return;
        }

        isLoading = true;
        mensagem = string.Empty;
        StateHasChanged();

        try
        {
            var resultado = await TerceiroService.UpdateTerceiroAsync(terceiro);

            if (resultado)
            {
                sucesso = true;
                mensagem = "Terceiro atualizado com sucesso!";

                // Redirecionar após 1 segundo
                await Task.Delay(1000);
                Navigation.NavigateTo("/terceiros");
            }
            else
            {
                sucesso = false;
                mensagem = "Erro ao atualizar terceiro. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            sucesso = false;
            mensagem = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/terceiros");
    }
}
